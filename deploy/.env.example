# Dockra server configuration. Copy to deploy/.env and adjust.
# install.sh replaces every "change-me" value with a random secret on first install.
# Full reference: docs/configuration.md

# ---- Secrets (never commit the real .env) ----
DJANGO_SECRET_KEY=change-me-secret
POSTGRES_PASSWORD=change-me-db
# Encrypts sensitive data at rest (app env vars, database passwords). Do not change it after install.
DOCKRA_ENCRYPTION_KEY=change-me-encryption
DOCKRA_ADMIN_PASSWORD=change-me-admin

# ---- Addresses ----
PUBLIC_IP=127.0.0.1
ACME_EMAIL=admin@example.com
# Panel and API domains behind Traefik (automatic HTTPS once DNS points at the server).
API_DOMAIN=api.127.0.0.1.sslip.io
PANEL_DOMAIN=panel.127.0.0.1.sslip.io
API_PUBLIC_URL=http://127.0.0.1:8000
PANEL_ORIGIN=http://127.0.0.1:3000
# With HTTPS domains, set both to 127.0.0.1 so the raw ports 8000 and 3000 are closed to the outside.
API_BIND=0.0.0.0
PANEL_BIND=0.0.0.0
# Default app domain with a wildcard DNS record (e.g. *.apps.example.com -> server IP). Empty = <app>.<ip>.sslip.io
DOCKRA_APPS_DOMAIN=

# ---- Capacity (0 = detect from the host) ----
DOCKRA_HOST_CPU=0
DOCKRA_HOST_MEMORY_MB=0
DOCKRA_HOST_DISK_GB=0
DOCKRA_RESERVED_CPU=1
DOCKRA_RESERVED_MEMORY_MB=2048
DOCKRA_RESERVED_DISK_GB=20
# Shared CPU: an app's cores are a guaranteed share and it may burst up to this factor of idle cores (1 = hard cap).
DOCKRA_CPU_BURST=3
# Reservations are accepted up to this factor of capacity (1 = no overcommit).
DOCKRA_CPU_OVERCOMMIT=2
DOCKRA_MEMORY_OVERCOMMIT=1.2
# Above this percentage of real host memory, new or larger apps are rejected and an alert fires.
DOCKRA_MEMORY_REAL_PERCENT=85
# Concurrent builds (each builder uses roughly half a core).
DOCKRA_BUILDERS=1

# ---- Backups ----
# Automatic database backups: every N hours (0 = off) and how many to keep. Each database can override it.
DOCKRA_AUTO_BACKUP_HOURS=24
DOCKRA_BACKUP_KEEP=3
# Automatic backups of app disk files (0 = off) and how many copies to keep.
DOCKRA_DISK_BACKUP_HOURS=24
DOCKRA_DISK_BACKUP_KEEP=3
# Off-site copies on any S3-compatible storage (AWS S3, MinIO, Backblaze B2, ...). Empty = off.
DOCKRA_S3_ENDPOINT=
DOCKRA_S3_BUCKET=
DOCKRA_S3_ACCESS_KEY=
DOCKRA_S3_SECRET_KEY=
DOCKRA_S3_REGION=us-east-1
DOCKRA_S3_PREFIX=dockra

# ---- Notifications and monitoring ----
# Deploy and alert notifications (optional). DOCKRA_TELEGRAM_API allows a Telegram API proxy.
DOCKRA_TELEGRAM_BOT_TOKEN=
DOCKRA_TELEGRAM_CHAT_ID=
DOCKRA_TELEGRAM_API=https://api.telegram.org
DOCKRA_NOTIFY_WEBHOOK=
# Alert when CPU, memory or disk stays above this percentage.
DOCKRA_ALERT_PERCENT=90
DOCKRA_LOG_DAYS=14

# ---- Terminal and database admin ----
# Set if the terminal is served from a different address (e.g. wss://api.example.com/ws).
DOCKRA_TERMINAL_PUBLIC_URL=
# Database admin UIs (pgAdmin, phpMyAdmin, ...) under /dbadmin on the API domain; closed after this many idle minutes.
DOCKRA_DBADMIN_IDLE_MINUTES=60
# Set if the API is reached through Traefik at another address; empty = the address the panel uses.
DOCKRA_DBADMIN_URL=
# Images can be pointed at a private registry: DOCKRA_PGADMIN_IMAGE, DOCKRA_PHPMYADMIN_IMAGE,
# DOCKRA_MONGO_EXPRESS_IMAGE, DOCKRA_REDIS_COMMANDER_IMAGE

# ---- Package mirrors and restricted networks (optional) ----
# Faster or air-gapped builds through your own mirrors.
DOCKRA_APT_MIRROR=
DOCKRA_PIP_INDEX_URL=
DOCKRA_PIP_FALLBACK_MIRROR=
DOCKRA_NPM_REGISTRY=
# Docker Hub mirrors (space separated). install.sh writes them to the Docker daemon (Docker restart).
DOCKRA_DOCKER_MIRRORS=
# Resolvers used by the domain "check record" when the container resolver fails (comma separated).
DOCKRA_DNS_SERVERS=
# Let's Encrypt needs public internet. Without it, leave empty and put certificates in /var/lib/dockra/certs.
DOCKRA_TLS_RESOLVER=le
# How long the pip/npm build cache is kept (hours). On isolated networks this cache is the package source.
DOCKRA_BUILD_CACHE_HOURS=720

# ---- HTTP hardening ----
# HSTS on panel and API HTTPS (seconds). Enable only once HTTPS is stable, e.g. 31536000.
DOCKRA_HSTS_SECONDS=0
# Extra origins the panel may connect to (space separated), e.g. a terminal on another domain.
DOCKRA_PANEL_CONNECT_SRC=
